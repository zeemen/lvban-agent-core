# 本地 Docker（端口有意避开默认 5432/6379，避免与本机已有实例冲突）
DATABASE_URL=postgres://lvban:lvban_dev@localhost:55432/lvban
REDIS_URL=redis://localhost:56379
PORT=8791

# ─────────────────────────── 微信登录 ───────────────────────────
# 小程序后台 → 开发管理 → 开发设置。appsecret 只能放服务端：
# code2Session 文档明写此接口不可在前端直接调用。
WX_APPID=
WX_APPSECRET=

# 强制鉴权。不设时跟着 WX_APPSECRET 走（配了密钥即强制），
# 开启后：无令牌不能开旅程，且 /v1/dev/users 这个无鉴权造身份的后门返回 404。
# AUTH_REQUIRED=true

# ─────────────────────────── Model Router ───────────────────────────
# mock | dashscope（通义千问）| ark（豆包）| deepseek
MODEL_PROVIDER=mock

# 按任务单独指定供应商（可选）。视觉和文本的最优供应商未必是同一家。
# MODEL_PROVIDER_VISION=dashscope

# API Key：优先读供应商专属变量，其次 MODEL_API_KEY
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
MODEL_API_KEY=

# 覆盖供应商档案里的 baseUrl（如百炼的业务空间专属域名）
# MODEL_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型 ID 按任务覆盖。档案里的默认值只是「上次核实时」的值，
# 模型 ID 变动比代码发布频繁，先跑 node --run models:probe 看账号实际可用的模型。
#
# 视觉能力是**模型**的属性：同一个 DeepSeek 账号，deepseek-flash 吃图片、
# deepseek-v4-pro 不吃。配错时不会崩，而是降级到「问一句」并给出原因。
#
# 火山引擎方舟必填：它的 model 字段要填推理接入点 ID（ep-xxxx）
# MODEL_ID_INTENT=
# MODEL_ID_QA=
# MODEL_ID_PLANNER=
# MODEL_ID_COPY=
# MODEL_ID_TRAVELOGUE=
# MODEL_ID_VISION=
# MODEL_ID_EMBEDDING=

# 按任务控制深度思考（on/off）。不设则用内置策略：
# 对话类（intent/qa/copy）关闭——实测首字延迟 3.7s → 1.2s；
# planner 保留——它不在用户等待的关键路径上。
# MODEL_THINKING_QA=off
# MODEL_THINKING_PLANNER=on

# 让适配器契约测试跑真实供应商（不设则跳过那组用例）
# PROBE_PROVIDER=deepseek

# ─────────────────────────── TTS（语音合成）───────────────────────────
# mock | tencent（腾讯云，首选：小程序同生态）| volcengine（火山引擎）
# 未配置时产品降级为「只显示文字」，不会报错
TTS_PROVIDER=mock

# 腾讯云：访问管理 → API 密钥。鉴权是 TC3-HMAC-SHA256 签名，适配器已处理
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-guangzhou
# TTS_SAMPLE_RATE=16000      # 16000 默认；24000 仅部分音色支持

# 音色。腾讯云是**整数 ID**（控制台「音色列表」查），火山是字符串代号。
# 两家都要在控制台开通授权。不配时用的是未经核实的占位值，presynth 会告警。
# 三副面孔三种音色：同游搭子 / 六朝书童 / 轻导览（企划书第 03 节）
# TTS_VOICE_PEER=
# TTS_VOICE_CHILD=
# TTS_VOICE_LIGHT=
# TTS_VOICE_PEER_SPEED=1.05

# 火山引擎（备选，保留适配器以便 A/B 音质）
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
# VOLC_TTS_CLUSTER=volcano_tts

# ──────────────────────── K3 长尾检索（WeKnora）────────────────────────
# 证据链第三级（规格 03 §5）。只调它的检索接口取 chunk，生成留在本服务：
# 受限通道、口吻守卫、maxChars 这些约束都在我们这边。
# 不配 BASE_URL 或 API_KEY 就整段跳过，回答照常，只是没有长尾证据。
# WEKNORA_BASE_URL=http://localhost:8080
# API Key 在 WeKnora Web 界面「账户设置」里生成，capability 选 retrieve 即可
# WEKNORA_API_KEY=
# 场景 → 知识库 ID，逗号分隔。场景取锚点的 sceneId；没配到的场景会全库搜
# WEKNORA_KB_IDS=fuzimiao=<kb-id>,nanjing_museum=<kb-id>
# 超时宁可短：它挂了只该少一条引用，不该卡住这句话（实测本地 BM25 约 23ms）
# WEKNORA_TIMEOUT_MS=800
# WEKNORA_MAX_PASSAGES=3
