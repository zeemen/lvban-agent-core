# 本地 Docker（端口有意避开默认 5432/6379，避免与本机已有实例冲突）
DATABASE_URL=postgres://lvban:lvban_dev@localhost:55432/lvban
REDIS_URL=redis://localhost:56379
PORT=8787

# ─────────────────────────── Model Router ───────────────────────────
# mock | dashscope（通义千问）| ark（豆包）| deepseek
MODEL_PROVIDER=mock

# 按任务单独指定供应商（可选）。视觉和文本的最优供应商未必是同一家。
# MODEL_PROVIDER_VISION=dashscope

# API Key：优先读供应商专属变量，其次 MODEL_API_KEY
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
MODEL_API_KEY=

# 覆盖供应商档案里的 baseUrl（如百炼的业务空间专属域名）
# MODEL_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型 ID 按任务覆盖。档案里的默认值只是「上次核实时」的值，
# 模型 ID 变动比代码发布频繁，先跑 node --run models:probe 看账号实际可用的模型。
#
# 视觉能力是**模型**的属性：同一个 DeepSeek 账号，deepseek-flash 吃图片、
# deepseek-v4-pro 不吃。配错时不会崩，而是降级到「问一句」并给出原因。
#
# 火山引擎方舟必填：它的 model 字段要填推理接入点 ID（ep-xxxx）
# MODEL_ID_INTENT=
# MODEL_ID_QA=
# MODEL_ID_PLANNER=
# MODEL_ID_COPY=
# MODEL_ID_VISION=
# MODEL_ID_EMBEDDING=

# 让适配器契约测试跑真实供应商（不设则跳过那组用例）
# PROBE_PROVIDER=dashscope
