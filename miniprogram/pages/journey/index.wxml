<view class="page">

  <!-- 授权：规格 01 §2.3，定位与轨迹保存分别说明、分别选择 -->
  <view wx:if="{{!consentGiven}}" class="card consent">
    <view class="title">开始今天的旅程<text class="sub">{{sceneName}}</text></view>
    <view class="hint">
      只有现在开始之后才会采集位置。行程结束时可以看到记了什么，并一键删除。
    </view>

    <!-- PRD U02：行前提醒一次，但不挡——建档本来就可以跳过 -->
    <view wx:if="{{suggestProfile}}" class="nudge">
      <view class="nudge-text">
        还没建档。三个问题，决定它用什么口吻跟你说话，一分钟不到。
      </view>
      <view class="nudge-actions">
        <text class="nudge-go" bindtap="onEditProfile">去建档</text>
        <text class="nudge-skip" bindtap="onDismissProfileNudge">先不用，按默认来</text>
      </view>
    </view>

    <!-- 让建档选的东西在开始之前就看得见，而不是开始之后才发现不对 -->
    <view wx:if="{{profileLoaded && !suggestProfile}}" class="prefs">
      <text class="prefs-text">这次按你建档选的来：{{modeName}} · {{voiceOn ? '念给你听' : '只显示文字'}}</text>
      <text class="prefs-edit" bindtap="onEditProfile">改一下</text>
    </view>
    <view wx:if="{{profileHint}}" class="hint warn">{{profileHint}}</view>

    <view class="label">轨迹保存</view>
    <radio-group bindchange="onConsentChange">
      <label class="radio"><radio value="none" checked="{{trackConsent === 'none'}}" />本次不保存轨迹</label>
      <label class="radio"><radio value="visited_points_only" checked="{{trackConsent === 'visited_points_only'}}" />仅保存访问点位</label>
      <label class="radio"><radio value="full_track" checked="{{trackConsent === 'full_track'}}" />保存完整轨迹</label>
    </radio-group>

    <button class="primary" bindtap="onStart" disabled="{{busy}}">开始今天的旅程</button>
  </view>

  <!-- 行中 -->
  <block wx:else>
    <!-- 室外靠围栏：开发者工具没有真实 GPS，点一下模拟走到 -->
    <view wx:if="{{!indoor}}" class="card pois">
      <view class="label">走到哪儿了<text class="sub">（开发者工具没有真实 GPS，点一下模拟走到）</text></view>
      <view class="poi-row">
        <button
          wx:for="{{pois}}" wx:key="id"
          class="poi {{currentPoi === item.id ? 'active' : ''}}"
          data-id="{{item.id}}" bindtap="onArrive" disabled="{{busy}}"
        >{{item.name}}</button>
      </view>
    </view>

    <!--
      室内不问「人在哪」，只问「在看哪件」（规格 02 §4.4）。
      命中率跌破阈值时这一档让位给「问一句」（§4.3）：按钮降级成次要样式，
      并把原因说出来，而不是悄悄把它藏起来。
    -->
    <view wx:if="{{indoor}}" class="card shoot">
      <view class="label">在看哪一件<text class="sub">（室内不定位，也不猜你在哪）</text></view>
      <button
        class="{{fallbackActive ? 'ghost' : 'primary'}}"
        bindtap="onShoot" disabled="{{busy}}"
      >拍一下这件展品</button>
      <view wx:if="{{fallbackHint}}" class="hint warn">{{fallbackHint}}</view>

      <!-- ask_user_pick：候选交给用户点，不替他选第一个 -->
      <block wx:if="{{picks.length}}">
        <view class="label">不太确定，是这几件里的哪一件？</view>
        <view class="poi-row">
          <button
            wx:for="{{picks}}" wx:key="exhibitId"
            class="poi" data-id="{{item.exhibitId}}" bindtap="onPick" disabled="{{busy}}"
          >{{item.name}}</button>
        </view>
        <text class="reject" bindtap="onRejectAll">都不是</text>
      </block>

      <!-- PRD U07：识别结果可纠正。纠正要撤回认错的那条落位 -->
      <view wx:if="{{correctable}}" class="correct">
        <text class="hint">认的是{{currentPoiName}}。</text>
        <text class="reject" bindtap="onNotThis">不是这件</text>
      </view>
    </view>

    <scroll-view class="dialog" scroll-y scroll-into-view="tail">
      <view wx:for="{{lines}}" wx:key="index" class="line {{item.kind}}">
        <view class="bubble">{{item.text}}</view>
        <!-- 静默卡片要用户自己点才出声：自动播就等于打断了 -->
        <view
          wx:if="{{item.kind === 'card' && item.audioKey && voiceOn}}"
          class="card-play" data-key="{{item.audioKey}}" bindtap="onPlayCard"
        >点一下听</view>
        <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
      </view>
      <view id="tail"></view>
    </scroll-view>

    <view wx:if="{{timing}}" class="timing">
      <text>{{timing}}</text>
      <text class="sub">TTS：{{ttsProvider}}</text>
    </view>

    <view class="composer">
      <input
        class="input" value="{{input}}" bindinput="onInput"
        placeholder="{{currentPoiName ? '在' + currentPoiName + '问一句' : '问一句'}}"
        confirm-type="send" bindconfirm="onAsk"
      />
      <button class="send" bindtap="onAsk" disabled="{{busy || !input}}">问</button>
    </view>

    <view class="footer">
      <button class="ghost" bindtap="onEnd">结束旅程</button>
      <button class="danger" bindtap="onDelete">删除本次记录</button>
    </view>
  </block>

  <view class="disclaimer">AI 生成内容仅供参考 · AI 服务，非持证导游</view>
</view>
