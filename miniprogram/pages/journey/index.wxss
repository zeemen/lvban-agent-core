/* 行中页私有样式。通用版式见 app.wxss */
.poi-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.poi { font-size: 26rpx; padding: 10rpx 24rpx; margin: 0; background: #f0eade; color: #4a4036; border-radius: 999rpx; line-height: 1.8; }
.poi.active { background: #2b2622; color: #f3efe7; }
.poi::after { border: none; }

.dialog { flex: 1; min-height: 480rpx; }
.line { margin-bottom: 24rpx; }
.bubble { display: inline-block; max-width: 86%; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 30rpx; line-height: 1.7; }
.line.user { text-align: right; }
.line.user .bubble { background: #2b2622; color: #f3efe7; }
.line.agent .bubble { background: #fffdf8; border: 1rpx solid #e3dbcb; }
.line.filler .bubble { background: #ece4d4; color: #6b6153; font-style: italic; }
.line.system .bubble { background: transparent; color: #9a8f80; font-size: 26rpx; padding: 0; }
/* 静默卡片：看得见但不抢注意力——它的本意就是没打断你 */
.line.card .bubble { background: #fffdf8; border: 1rpx dashed #c9bda6; color: #6b6153; }
.card-play { display: inline-block; margin-top: 8rpx; font-size: 24rpx; color: #8a6d3b; border-bottom: 1rpx solid #d8c9a8; }
.note { font-size: 22rpx; color: #a99e8e; margin-top: 8rpx; }

.timing { font-size: 22rpx; color: #8a7f70; padding: 12rpx 4rpx; display: flex; gap: 16rpx; }

.composer { display: flex; gap: 12rpx; padding: 16rpx 0; }
.input { flex: 1; background: #fffdf8; border: 1rpx solid #e3dbcb; border-radius: 12rpx; padding: 20rpx; font-size: 30rpx; }
.send { width: 120rpx; background: #2b2622; color: #f3efe7; font-size: 30rpx; margin: 0; }
.send::after { border: none; }

.footer { display: flex; gap: 16rpx; }
.footer .ghost, .footer .danger { flex: 1; }


/* 开始之前就告诉用户这次会是什么样子 */
.prefs {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
}
.prefs-text { font-size: 26rpx; color: #6b5f52; }
.prefs-edit { font-size: 26rpx; color: #8a5a2b; text-decoration: underline; flex: none; }
.hint.warn { color: #b4472a; }

/* 行前提醒：看得见，但不挡路 */
.nudge {
  margin: 16rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: #fbf6ec;
  border: 1rpx solid #e3d8c4;
  border-radius: 12rpx;
}
.nudge-text { font-size: 26rpx; color: #6b5f52; line-height: 1.6; }
.nudge-actions { display: flex; gap: 32rpx; margin-top: 12rpx; }
.nudge-go { font-size: 26rpx; color: #8a5a2b; text-decoration: underline; }
.nudge-skip { font-size: 26rpx; color: #9a9088; }
